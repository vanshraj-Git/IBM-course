import pandas as pd  # For data handling
import numpy as np  # For numerical operations
import re  # For regular expressions
import random  # For random operations
import itertools  # For confusion matrix plotting
import matplotlib.pyplot as plt  # For visualization

from sklearn import tree  # Decision tree classifier
from sklearn.metrics import accuracy_score, confusion_matrix  # For evaluation

# Download dataset if not already present
import os
import requests

url = "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-DS0103EN-SkillsNetwork/labs/Module%202/recipes.csv"
filename = "recipes.csv"

if not os.path.exists(filename):
    print("Downloading the dataset...")
    response = requests.get(url)
    with open(filename, "wb") as f:
        f.write(response.content)

recipes = pd.read_csv(filename)
print("Data read into dataframe!")
import matplotlib
matplotlib.use('TkAgg')  # Use TkAgg backend for interactive plotting

# Fix column names
recipes.columns.values[0] = "cuisine"
recipes["cuisine"] = recipes["cuisine"].str.lower()

# Standardize cuisine names
standardize_map = {
    "austria": "austrian", "belgium": "belgian", "china": "chinese",
    "canada": "canadian", "netherlands": "dutch", "france": "french",
    "germany": "german", "india": "indian", "indonesia": "indonesian",
    "iran": "iranian", "italy": "italian", "japan": "japanese",
    "israel": "jewish", "korea": "korean", "lebanon": "lebanese",
    "malaysia": "malaysian", "mexico": "mexican", "pakistan": "pakistani",
    "philippines": "philippine", "scandinavia": "scandinavian",
    "spain": "spanish_portuguese", "portugal": "spanish_portuguese",
    "switzerland": "swiss", "thailand": "thai", "turkey": "turkish",
    "vietnam": "vietnamese", "uk-and-ireland": "uk-and-irish", "irish": "uk-and-irish"
}
recipes["cuisine"] = recipes["cuisine"].replace(standardize_map)

# Remove cuisines with fewer than 50 recipes
recipes_counts = recipes["cuisine"].value_counts()
cuisines_to_keep = recipes_counts[recipes_counts > 50].index
recipes = recipes[recipes["cuisine"].isin(cuisines_to_keep)]

# Convert "Yes" to 1 and "No" to 0
recipes = recipes.replace({"Yes": 1, "No": 0})

# Select specific cuisines for decision tree modeling
asian_indian_recipes = recipes[recipes["cuisine"].isin(["korean", "japanese", "chinese", "thai", "indian"])]
cuisines = asian_indian_recipes["cuisine"]
ingredients = asian_indian_recipes.iloc[:, 1:]

# Train a decision tree classifier
bamboo_tree = tree.DecisionTreeClassifier(max_depth=3)
bamboo_tree.fit(ingredients, cuisines)
print("Decision tree model saved to bamboo_tree!")

# Plot the decision tree
plt.figure(figsize=(40, 20))
_ = tree.plot_tree(
    bamboo_tree, feature_names=ingredients.columns, class_names=np.unique(cuisines),
    filled=True, node_ids=True, impurity=False, label="all", fontsize=20, rounded=True
)
plt.show()

# Create training and test datasets
sample_n = 30
random.seed(1234)
bamboo_test = asian_indian_recipes.groupby("cuisine", group_keys=False).apply(lambda x: x.sample(sample_n))

bamboo_test_ingredients = bamboo_test.iloc[:, 1:]
bamboo_test_cuisines = bamboo_test["cuisine"]

bamboo_train = asian_indian_recipes.loc[~asian_indian_recipes.index.isin(bamboo_test.index)]
bamboo_train_ingredients = bamboo_train.iloc[:, 1:]
bamboo_train_cuisines = bamboo_train["cuisine"]

# Train a deeper decision tree
bamboo_train_tree = tree.DecisionTreeClassifier(max_depth=15)
bamboo_train_tree.fit(bamboo_train_ingredients, bamboo_train_cuisines)
print("Decision tree model saved to bamboo_train_tree!")

# Plot the trained tree
plt.figure(figsize=(40, 20))
_ = tree.plot_tree(
    bamboo_train_tree, feature_names=bamboo_train_ingredients.columns, class_names=np.unique(bamboo_train_cuisines),
    filled=True, node_ids=True, impurity=False, label="all", fontsize=10, rounded=True
)
plt.show()

# Make predictions and evaluate the model
bamboo_pred_cuisines = bamboo_train_tree.predict(bamboo_test_ingredients)

bamboo_confusion_matrix = confusion_matrix(bamboo_test_cuisines, bamboo_pred_cuisines, labels=np.unique(bamboo_test_cuisines))
bamboo_confusion_matrix = (bamboo_confusion_matrix.astype('float') / bamboo_confusion_matrix.sum(axis=1)[:, np.newaxis]) * 100

# Plot the confusion matrix
plt.figure(figsize=(8, 6))
plt.imshow(bamboo_confusion_matrix, interpolation='nearest', cmap=plt.cm.Blues)
plt.title('Bamboo Confusion Matrix')
plt.colorbar()
tick_marks = np.arange(len(np.unique(bamboo_test_cuisines)))
plt.xticks(tick_marks, np.unique(bamboo_test_cuisines))
plt.yticks(tick_marks, np.unique(bamboo_test_cuisines))

thresh = bamboo_confusion_matrix.max() / 2.
for i, j in itertools.product(range(bamboo_confusion_matrix.shape[0]), range(bamboo_confusion_matrix.shape[1])):
    plt.text(j, i, f"{bamboo_confusion_matrix[i, j]:.2f}", horizontalalignment="center",
             color="white" if bamboo_confusion_matrix[i, j] > thresh else "black")

plt.tight_layout()
plt.ylabel('True label')
plt.xlabel('Predicted label')
plt.show()
